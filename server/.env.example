# Sahaya Welfare Portal - Server Environment Variables Example
PORT=5000
NODE_ENV=development
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:3000

# Supabase PostgreSQL Configuration
# Obtain these values from your Supabase Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
# Backend operations use the service-role key for administrative access:
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Set to true to route all database operations to Supabase PostgreSQL:
USE_SUPABASE=false
